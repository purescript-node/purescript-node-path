{
  "private": true,
  "scripts": {
    "build": "spago build --pedantic-packages --strict",
    "test": "spago test --pedantic-packages",
    "lint": "oxlint src test --deny-warnings",
    "format": "purs-tidy format-in-place 'src/**/*.purs' 'test/**/*.purs' && oxfmt --write 'src/**/*.js' 'test/**/*.js'",
    "format:check": "purs-tidy check 'src/**/*.purs' 'test/**/*.purs' && oxfmt --check 'src/**/*.js' 'test/**/*.js'"
  },
  "devDependencies": {
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "purs-tidy": "0.11.1",
    "purescript": "0.15.16",
    "spago": "1.0.4"
  }
}
